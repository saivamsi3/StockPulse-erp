# Server configuration - copy to .env and fill in real values
NODE_ENV=development
PORT=5000

# PostgreSQL connection
# Example for local: postgres://postgres:postgres@localhost:5432/stockpulse
# Example for Neon/Supabase/Render: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/stockpulse

# JWT secret - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# CORS allowed origin(s), comma separated
# Example: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173
